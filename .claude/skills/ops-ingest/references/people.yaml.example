# Person → project routing for /ops-ingest
# Copy to ${AI_OS_SKILL_CONFIG_DIR:-context/config}/ops-ingest/people.yaml
# (private — never commit your real one)

people:
  - name: Jane Doe
    aliases: [jane, jane@acme.com, "Jane D"]   # transcript speaker labels, emails, nicknames
    project: Acme App
    repo: myorg/acme-app          # where extracted issues get filed
    project_record: projects/ops-project-management/acme.md  # optional existing project record
    reply_channel: text           # text | email | slack | dm
    tone: "casual, brief, no corporate-speak"

  - name: Sam Partner
    aliases: [sam, samuel]
    project: Big SaaS
    repo: myorg/big-saas
    project_record: projects/ops-project-management/big-saas.md
    reply_channel: email
    tone: "warm but structured; they like numbered lists"

defaults:
  issue_labels: [from-ingest]   # applied to every filed issue; [] to disable
  project_capture: true         # set false to skip additional project records unless asked
