# Optional: absolute path to the AIOS workspace root.
#
# The launcher auto-detects this when unset. Only set it if command-centre
# should read and write against a different checkout than the one it is running from.
#
# AI_OS_DIR=/absolute/path/to/AI-OS

# Optional: hosted team memory — Postgres + pgvector (Railway or VPS).
#
# When MEMORY_DATABASE_URL (or DATABASE_URL) is set, ALL memory commands
# (memory:migrate / memory:index / memory:search / memory:recall) run against
# hosted Postgres — the same schema local PGLite runs. Unset → local PGLite.
# Falls back to DATABASE_URL (Railway injects it). Never commit a real value.
#
# MEMORY_DATABASE_URL=postgres://user:password@host:5432/ai_memory
# PGSSLMODE=        # disable | require | no-verify (default: on for remote, off for localhost)
#
# Optional: pin the storage engine. auto (default) = Postgres iff a connection
# string is set, else PGLite. `postgres` REQUIRES a URL (errors rather than
# silently using the local store); `pglite` forces local and ignores any URL.
# MEMORY_STORE_BACKEND=auto   # auto | pglite | postgres

# Optional: public Team OS URL used for invite/reset links printed by hosted
# commands. In Docker/production, team:owner-reset requires one of these or
# a --base-url flag so it never prints localhost by mistake.
# MEMORY_API_PUBLIC_URL=https://team-os.example.com
# TEAM_OS_PUBLIC_URL=https://team-os.example.com

# Required for Team OS shared secrets and encrypted .mcp.json backup.
# This key encrypts team/client API keys and private config backups at rest.
# Do not reuse BETTER_AUTH_SECRET.
# Generate a 32-byte base64url key with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# TEAM_OS_SECRETS_KEYS=v1:<base64url-32-byte-key>
# TEAM_OS_SECRETS_ACTIVE_KEY_ID=v1

# Optional: private Git backup for the hosted AI-OS workspace files.
# This backs up the full AI_OS_DIR, including secret files, so use only a
# private repository/remote.
# TEAM_OS_WORKSPACE_BACKUP_REMOTE=git@github.com:your-org/private-team-os-backup.git
# TEAM_OS_WORKSPACE_BACKUP_BRANCH=main
# TEAM_OS_WORKSPACE_BACKUP_USER_NAME=Team OS Backup
# TEAM_OS_WORKSPACE_BACKUP_USER_EMAIL=team-os-backup@example.invalid
