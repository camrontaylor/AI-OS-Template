{
  "version": 1,
  "description": "AI-OS update ownership contract. AI-OS owned paths can be refreshed from upstream. User owned paths are never overwritten by updates. never_publish paths are read only by scripts/template-sync.sh and are never propagated to the public template (proprietary or unverified-license third-party material, per skills-library/LICENSES.md).",
  "ai_os_owned": [
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "CHANGELOG.md",
    "VERSION",
    ".cursor/rules/ai-os.mdc",
    ".claude/commands/",
    ".claude/hooks/",
    ".claude/skills/*/SKILL.md",
    ".claude/skills/*/references/",
    ".claude/skills/*/assets/",
    ".claude/skills/*/evals/",
    ".claude/skills/*/scripts/",
    ".claude/skills/*/agents/",
    ".claude/skills/*/eval-viewer/",
    ".claude/skills/*/package.json",
    ".claude/skills/ATTRIBUTION.md",
    ".claude/skills/_catalog/catalog.json",
    "command-centre/",
    ".aios/optional/",
    ".aios/README.md",
    "config/",
    "context/agency/",
    "context/thinking/",
    "docs/",
    "scripts/",
    "skills-library/",
    "templates/",
    "cron/templates/",
    ".github/"
  ],
  "user_owned": [
    ".env",
    ".mcp.json",
    ".claude/settings.local.json",
    ".claude/skills/_catalog/installed.json",
    ".claude/skills/*/SKILL.local.md",
    ".claude/skills/*/*.local.md",
    "CLAUDE.local.md",
    "command-centre/src/components/marketing/marketing-plan-view.tsx",
    "scripts/notion-sync/com.camron.notion-sync.plist",
    "context/MEMORY.md",
    "context/USER.md",
    "context/SOUL.md",
    "context/learnings.md",
    "context/memory/",
    "context/notion/",
    "context/_private/",
    "brand_context/",
    "clients/",
    "projects/",
    "cron/jobs/",
    "cron/logs/",
    "cron/status/",
    ".command-centre/",
    ".memsearch/",
    ".aios/enabled/"
  ],
  "never_publish": [
    "skills-library/backlog/cf-frameworks/",
    "skills-library/backlog/planner/",
    "skills-library/backlog/copy-qa/",
    "skills-library/backlog/community-claude-md-rules/",
    ".claude/skills/ops-website/",
    ".claude/skills/str-sitemap-workshop/"
  ],
  "local_override_guidance": [
    "Put skill edits in SKILL.local.md beside the upstream SKILL.md.",
    "Put Claude-specific instruction overrides in CLAUDE.local.md.",
    "Keep memories, clients, brand context, projects, API keys, and cron jobs in user-owned paths."
  ]
}
