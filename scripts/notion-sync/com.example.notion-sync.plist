<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.notion-sync</string>

    <!--
      Runs run-notion-sync.sh every 15 minutes (900 seconds). The sync is
      credit-free and incremental (only pages edited since the last run), so a
      frequent poll is cheap and makes new Stack/Resources pages show up in
      AI-OS within minutes of saving them - close enough to a live trigger
      without any webhook, tunnel, or extra service to keep alive. The nightly
      memsearch index (23:30) still picks up context/notion/ once a day.

      IMPORTANT: the two ProgramArguments paths and the WorkingDirectory below
      are absolute and must match this machine. If you move the repo, update
      them and reload the job (see README.md).
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/ABSOLUTE/PATH/TO/AI-OS/scripts/notion-sync/run-notion-sync.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/ABSOLUTE/PATH/TO/AI-OS</string>

    <key>StartInterval</key>
    <integer>900</integer>

    <!--
      If the Mac is asleep when a run is due, launchd coalesces it and runs once
      at the next wake. The sync is incremental, so it catches up regardless.
    -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Logs for debugging. Both files are inside the gitignored sync folder. -->
    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/AI-OS/context/notion/sync.log</string>
    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/AI-OS/context/notion/sync.err.log</string>

    <!--
      Give the job a usable PATH so it can find python3 and memsearch.
      memsearch installs to ~/.local/bin; Homebrew lives in /opt/homebrew/bin
      on Apple Silicon and /usr/local/bin on Intel.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/ABSOLUTE/PATH/TO/HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
